GPU_RENDERERS = _load_gpus()


def _legacy_set():
    """Renderer dari gpus-extra.json = kartu lama/low-end."""
    try:
        raw = json.loads((VAULT / "gpus-extra.json").read_text())
        return {e["renderer"] for v in raw.values() if isinstance(v, list) for e in v}
    except Exception:
        return set()


LEGACY_RENDERERS = _legacy_set()


def gpu_model_choices(vendor):
    return [r for _, r in GPU_RENDERERS.get(vendor, [])]


def resolve_gpu_model(text, vendor=None):
    """Resolve full ANGLE renderer from a substring ('RTX 3080' -> ANGLE string)."""
    if not text:
        return None
    if text.startswith("ANGLE"):
        return text
    pool = []
    for v, items in GPU_RENDERERS.items():
        if vendor and v != vendor:
            continue
        pool += [r for _t, r in items]
    if not pool:
        pool = [r for v in GPU_RENDERERS for _t, r in GPU_RENDERERS[v]]
    hit = [r for r in pool if text.lower() in r.lower()]
    return hit[0] if hit else None


def random_gpu_renderer(vendor=None, tier=None):
    import random as _r
    pool = []
    for v, items in GPU_RENDERERS.items():
        if vendor and v != vendor:
            continue
        for t, r in items:
            if tier and t != tier:
                continue
            pool.append(r)
    return _r.choice(pool) if pool else None


def gpu_tier(renderer):
    for v, items in GPU_RENDERERS.items():
        for t, r in items:
            if r == renderer:
                return t
    return None


def coherence_warning(meta):
    """Warn when the spec is incoherent (e.g. desktop GPU + 8 GB RAM)."""
    if meta.get("search"):
        apply_search_engine(profile, meta["search"])

    hw = meta.get("hw") or {}
    tier = gpu_tier(hw.get("gpu_renderer"))
    mem = hw.get("mem")
    cores = hw.get("cores")
    if tier == "desktop" and mem and int(mem) < 16:
        return f"Desktop GPU with {mem} GB RAM — most such machines run 16 GB+"
    if tier == "desktop" and cores and int(cores) < 8:
        return f"Desktop GPU with only {cores} cores — incoherent"
    if tier == "laptop" and mem and int(mem) > 16:
        return f"Laptop GPU with {mem} GB RAM — rare, but it exists"
    if hw.get("gpu_renderer") in LEGACY_RENDERERS:
        if (cores and int(cores) > 8) or (mem and int(mem) > 16):
            return (f"{short_gpu(hw['gpu_renderer'])} is an old card — "
                    f"{cores or '?'} cores / {mem or '?'} GB looks incoherent")
    return None


def short_gpu(renderer):
    """'ANGLE (NVIDIA, NVIDIA GeForce RTX 3060 (0x00002504) ...)' -> 'RTX 3060'"""
    if not renderer:
        return "-"
    m = re.search(r"NVIDIA ([A-Za-z0-9 ]+?)(?: \(0x|,|$)", renderer)
    if m:
        return m.group(1).strip()
    m = re.search(r"Intel\(R\) ([A-Za-z0-9 ]+?)(?: \(0x|,|$)", renderer)
    if m:
        return m.group(1).strip()
    return renderer[:28]

