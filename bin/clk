def _load_gpus():
    """GPU catalog.

    Source: gpus.json (harvested from the binary = engine pool) +
    gpus-extra.json (older/low-end cards missing from the engine pool).
    """
    out = {}
    for fname in ("gpus.json", "gpus-extra.json"):
        f = VAULT / fname
        try:
            raw = json.loads(f.read_text())
        except Exception:
            continue
        for k, v in raw.items():
            if not isinstance(v, list):
                continue
            out.setdefault(k, [])
            for e in v:
                item = (e.get("tier", "desktop"), e["renderer"])
                if item not in out[k]:
                    out[k].append(item)
    return out or _GPU_FALLBACK

# --- GPU catalog (real Windows/D3D11 ANGLE strings) ---
